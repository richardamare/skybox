# 1Password references, resolved by `op run --env-file` on a Mac and by 1password/load-secrets-action in CI.
TF_VAR_cloudflare_api_token="op://skybox/Cloudflare API token/credential"
TF_VAR_cloudflare_zone_id="op://skybox/Cloudflare API token/Cloudflare/zone id"
TF_VAR_claude_code_oauth_token="op://skybox/Claude Code OAuth token/credential"
