#cloud-config
users:
  - default
  - name: agent
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
{{- range .SSHKeys }}
      - {{ json . }}
{{- end }}

package_update: true
packages: [git, curl, jq, unzip, tmux, build-essential, ca-certificates, ripgrep]

write_files:
  # Readable by root alone, so the agent account cannot run a second connector for this sandbox's hostname.
  - path: /etc/cloudflared/token
    permissions: "0600"
    content: {{ json .TunnelToken }}

  - path: /etc/systemd/system/cloudflared.service
    content: |
      [Unit]
      Description=Cloudflare tunnel to this sandbox's sshd
      Wants=network-online.target
      After=network-online.target

      [Service]
      ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
      Restart=always
      RestartSec=5

      [Install]
      WantedBy=multi-user.target

  # Writes the agent account's T3 Code service environment with the Claude token from Key Vault, on every boot so a
  # rotated token reaches the sandbox when it wakes. The server listens on loopback and publishes itself to the tailnet
  # with Tailscale Serve.
  - path: /usr/local/sbin/skybox-t3-env
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      imds="http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&resource=https%3A%2F%2Fvault.azure.net&client_id={{ .IdentityClientID }}"
      secret=""
      for _ in $(seq 24); do
        if access=$(curl -fsS -H Metadata:true "$imds" | jq -er .access_token) &&
          secret=$(curl -fsS -H "Authorization: Bearer $access" \
            "https://{{ .KeyVaultName }}.vault.azure.net/secrets/claude-code-oauth-token?api-version=7.4" | jq -er .value); then
          break
        fi
        sleep 5
      done
      [[ -n $secret ]] || { echo "could not read claude-code-oauth-token from Key Vault" >&2; exit 1; }
      install -d -o agent -g agent -m 0700 /home/agent/.t3
      umask 077
      next=$(mktemp /home/agent/.t3/.service.env.XXXXXX)
      printf 'T3CODE_HOST=127.0.0.1\nT3CODE_PORT=3773\nT3CODE_TAILSCALE_SERVE=true\nCLAUDE_CODE_OAUTH_TOKEN=%s\n' "$secret" >"$next"
      chown agent:agent "$next"
      mv "$next" /home/agent/.t3/service.env

  - path: /etc/systemd/system/skybox-t3-env.service
    content: |
      [Unit]
      Description=Write the agent account's T3 Code service environment
      Wants=network-online.target
      After=network-online.target
      Before=systemd-user-sessions.service

      [Service]
      Type=oneshot
      TimeoutStartSec=180
      ExecStart=/usr/local/sbin/skybox-t3-env

      [Install]
      WantedBy=multi-user.target

  # Readable by root alone. The auth key is single use and expires within minutes, and the join removes it.
  - path: /var/lib/skybox/tailnet-auth-key
    permissions: "0600"
    content: {{ json .TailnetAuthKey }}

  # Joins the tailnet as this sandbox on its first boot, with the tag its auth key carries. The agent account is the
  # operator, so the T3 Code server may run tailscale serve. tailscaled keeps the node on the disk, and a tagged node's
  # key never expires, so the sandbox wakes at the same address without joining again.
  - path: /usr/local/sbin/skybox-join-tailnet
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      trap 'rm -f /var/lib/skybox/tailnet-auth-key' EXIT
      for _ in $(seq 12); do
        tailscale up --auth-key=file:/var/lib/skybox/tailnet-auth-key --hostname={{ .Name }} --operator=agent && exit 0
        sleep 5
      done
      echo "could not join the tailnet" >&2
      exit 1

  # Runs as the agent account. The T3 Code server version is pinned, and the T3 Code desktop offers to update it.
  - path: /usr/local/lib/skybox/agent-setup.sh
    permissions: "0755"
    content: |
      #!/bin/bash
      set -euo pipefail
      cd "$HOME"
      curl -fsSL https://claude.ai/install.sh | bash
      curl -fsSL https://t3.codes/install.sh | T3CODE_VERSION={{ .T3Version }} sh
      mkdir -p .t3/userdata
      [[ -e .t3/userdata/settings.json ]] || printf '{"linkedEnvironmentsEnabled":true}\n' >.t3/userdata/settings.json
      [[ -e .claude.json ]] || printf '{"hasCompletedOnboarding":true}\n' >.claude.json
      cat >>.profile <<'PROFILE'
      CLAUDE_CODE_OAUTH_TOKEN=$(sed -n 's/^CLAUDE_CODE_OAUTH_TOKEN=//p' "$HOME/.t3/service.env" 2>/dev/null)
      export CLAUDE_CODE_OAUTH_TOKEN
      PROFILE
      export XDG_RUNTIME_DIR=/run/user/$(id -u)
      export DBUS_SESSION_BUS_ADDRESS=unix:path=$XDG_RUNTIME_DIR/bus
      .local/bin/t3 service install

runcmd:
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, skybox-t3-env.service]
  - [sh, -c, 'curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.noarmor.gpg -o /usr/share/keyrings/tailscale-archive-keyring.gpg']
  - [sh, -c, 'curl -fsSL https://pkgs.tailscale.com/stable/ubuntu/noble.tailscale-keyring.list -o /etc/apt/sources.list.d/tailscale.list']
  - [sh, -c, 'curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg -o /usr/share/keyrings/cloudflare-main.gpg']
  - [sh, -c, 'echo "deb [signed-by=/usr/share/keyrings/cloudflare-main.gpg] https://pkg.cloudflare.com/cloudflared any main" > /etc/apt/sources.list.d/cloudflared.list']
  - [sh, -c, 'apt-get update && apt-get install -y tailscale cloudflared']
  # Before the agent setup, so the T3 Code server is on the tailnet when it first starts.
  - [/usr/local/sbin/skybox-join-tailnet]
  - [loginctl, enable-linger, agent]
  - [sh, -c, 'for _ in $(seq 60); do [ -S /run/user/$(id -u agent)/bus ] && break; sleep 1; done']
  - [sudo, -iu, agent, /usr/local/lib/skybox/agent-setup.sh]
  # Last, so a connected tunnel tells skybox up that the sandbox is ready.
  - [systemctl, enable, --now, cloudflared.service]
